synthea_cdc:
  target: "{{ env_var('DBT_TARGET', 'local') }}"
  outputs:
    local:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', '127.0.0.1') }}"
      port: "{{ env_var('POSTGRES_PORT', '55432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'cdc_owner') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('WAREHOUSE_DATABASE', 'synthea_warehouse') }}"
      schema: analytics
      threads: 2
    redshift:
      type: redshift
      host: "{{ env_var('REDSHIFT_HOST', 'not-configured') }}"
      port: 5439
      user: "{{ env_var('REDSHIFT_USER', 'not-configured') }}"
      password: "{{ env_var('REDSHIFT_PASSWORD', 'not-configured') }}"
      dbname: "{{ env_var('REDSHIFT_DATABASE', 'synthea') }}"
      schema: analytics
      sslmode: verify-full
      threads: 2

