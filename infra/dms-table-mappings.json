{
  "rules": [
    {
      "rule-type": "selection",
      "rule-id": "1",
      "rule-name": "include-customers",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "customers"
      },
      "rule-action": "include"
    },
    {
      "rule-type": "selection",
      "rule-id": "2",
      "rule-name": "include-orders",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "orders"
      },
      "rule-action": "include"
    },
    {
      "rule-type": "selection",
      "rule-id": "3",
      "rule-name": "include-order_items",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "order_items"
      },
      "rule-action": "include"
    },
    {
      "rule-type": "selection",
      "rule-id": "4",
      "rule-name": "include-order_payments",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "order_payments"
      },
      "rule-action": "include"
    },
    {
      "rule-type": "transformation",
      "rule-id": "5",
      "rule-name": "name-initial-load-folder",
      "rule-target": "schema",
      "object-locator": {
        "schema-name": "ecommerce"
      },
      "rule-action": "rename",
      "value": "initial-load"
    },
    {
      "rule-type": "transformation",
      "rule-id": "10",
      "rule-name": "add-_source_lsn",
      "rule-target": "column",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "%"
      },
      "rule-action": "add-column",
      "value": "_source_lsn",
      "expression": "$AR_H_STREAM_POSITION",
      "data-type": {
        "type": "string",
        "length": 128
      }
    },
    {
      "rule-type": "transformation",
      "rule-id": "11",
      "rule-name": "add-_source_order",
      "rule-target": "column",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "%"
      },
      "rule-action": "add-column",
      "value": "_source_order",
      "expression": "$AR_H_CHANGE_SEQ",
      "data-type": {
        "type": "string",
        "length": 35
      }
    },
    {
      "rule-type": "transformation",
      "rule-id": "12",
      "rule-name": "add-_commit_at",
      "rule-target": "column",
      "object-locator": {
        "schema-name": "ecommerce",
        "table-name": "%"
      },
      "rule-action": "add-column",
      "value": "_commit_at",
      "expression": "$AR_H_COMMIT_TIMESTAMP",
      "data-type": {
        "type": "string",
        "length": 50
      }
    }
  ]
}
